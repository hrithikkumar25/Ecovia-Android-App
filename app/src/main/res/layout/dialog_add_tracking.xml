<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#2E2E2E">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Category"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textColorHint="#CCCCCC"
        app:endIconMode="dropdown_menu"
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="#424242"
        app:boxStrokeColor="@android:color/transparent"
        app:boxStrokeWidth="0dp">

        <AutoCompleteTextView
            android:id="@+id/spinnerDialogCategory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Select Category"
            android:inputType="none"
            android:textColor="#FFFFFF"
            android:textColorHint="#CCCCCC"
            android:textSize="14sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Activity"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textColorHint="#CCCCCC"
        app:endIconMode="dropdown_menu"
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="#424242"
        app:boxStrokeColor="@android:color/transparent"
        app:boxStrokeWidth="0dp">

        <AutoCompleteTextView
            android:id="@+id/spinnerDialogActivity"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Select Activity"
            android:inputType="none"
            android:textColor="#FFFFFF"
            android:textColorHint="#CCCCCC"
            android:textSize="14sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Value"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etDialogValue"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:background="#424242"
        android:hint="Enter value"
        android:inputType="numberDecimal"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#CCCCCC"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Unit"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etDialogUnit"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#424242"
        android:hint="Enter unit"
        android:inputType="text"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#CCCCCC"
        android:textSize="16sp" />

</LinearLayout>
