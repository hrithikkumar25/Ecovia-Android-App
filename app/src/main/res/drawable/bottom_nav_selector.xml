<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Selected/Checked State -->
    <item android:state_checked="true">
        <layer-list>
            <!-- Shadow Layer -->
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#20000000" />
                    <corners android:radius="16dp" />
                </shape>
            </item>

            <!-- Main Background -->
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="90"
                        android:startColor="#4CAF50"
                        android:centerColor="#45A049"
                        android:endColor="#3E8E41" />
                    <corners android:radius="16dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#2E7D32" />
                </shape>
            </item>

            <!-- Inner Glow Effect -->
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="90"
                        android:startColor="#66FFFFFF"
                        android:centerColor="#33FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="14dp" />
                </shape>
            </item>

            <!-- Outer Ring Effect -->
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <stroke
                        android:width="1dp"
                        android:color="#80FFFFFF" />
                    <corners android:radius="15dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Pressed State -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Shadow Layer -->
            <item android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#30000000" />
                    <corners android:radius="14dp" />
                </shape>
            </item>

            <!-- Main Background -->
            <item android:bottom="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="90"
                        android:startColor="#66BB6A"
                        android:centerColor="#5CB85C"
                        android:endColor="#4CAF50" />
                    <corners android:radius="14dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#388E3C" />
                </shape>
            </item>

            <!-- Inner Highlight -->
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#40FFFFFF" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Focused State -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Focus Ring -->
            <item>
                <shape android:shape="rectangle">
                    <stroke
                        android:width="2dp"
                        android:color="#4CAF50" />
                    <corners android:radius="16dp" />
                </shape>
            </item>

            <!-- Inner Content -->
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#10000000" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default/Unselected State -->
    <item>
        <layer-list>
            <!-- Subtle Shadow -->
            <item android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#10000000" />
                    <corners android:radius="12dp" />
                </shape>
            </item>

            <!-- Main Background -->
            <item android:bottom="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="90"
                        android:startColor="#F8F9FA"
                        android:centerColor="#F1F3F4"
                        android:endColor="#E8EAED" />
                    <corners android:radius="12dp" />
                    <stroke
                        android:width="0.5dp"
                        android:color="#DADCE0" />
                </shape>
            </item>

            <!-- Inner Subtle Highlight -->
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="90"
                        android:startColor="#20FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="11dp" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
